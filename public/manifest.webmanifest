{
  "name": "OrderNook",
  "short_name": "OrderNook",
  "description": "Manage your shop, menu, and orders.",
  "start_url": "/dashboard?src=pwa",
  "scope": "/",
  "display": "standalone",
  "theme_color": "#7B61FF",
  "background_color": "#F4F1FF",
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
